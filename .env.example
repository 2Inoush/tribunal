# Copier ce fichier en .env puis adapter les valeurs.
# .env n'est jamais versionne (voir .gitignore) : chacun a le sien.

APP_URL=http://localhost:8888/tribunal/public
APP_DEBUG=true

# MAMP    : port 8889, utilisateur root, mot de passe root
# php -S  : port 3306, utilisateur root, mot de passe vide
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=tribunal
DB_USER=root
DB_PASS=root
